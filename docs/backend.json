{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        }
      },
      "required": ["displayName", "email"]
    },
    "SmartView": {
      "title": "SmartView",
      "description": "A saved view for filtering and sorting entities in Q-Sales.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["system", "custom"] },
        "entity": { "type": "string", "enum": ["leads"] },
        "name": { "type": "string" },
        "scope": { "type": "string", "enum": ["private", "team", "org"] },
        "createdBy": { "type": "object", "properties": { "userId": { "type": "string" }, "name": { "type": "string" } } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "isArchived": { "type": "boolean" },
        "filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "operator": { "type": "string" },
              "value": {}
            }
          }
        },
        "sort": {
          "type": "object",
          "properties": {
            "field": { "type": "string" },
            "direction": { "type": "string", "enum": ["asc", "desc"] }
          }
        },
        "ui": {
            "type": "object",
            "properties": {
                "icon": { "type": "string" },
                "color": { "type": "string" },
                "description": { "type": "string" }
            }
        },
        "permissions": {
            "type": "object",
            "properties": {
                "editableBy": { "type": "string", "enum": ["owner", "team", "admin"] }
            }
        }
      },
      "required": ["id", "type", "entity", "name", "scope", "createdBy", "createdAt", "updatedAt"]
    },
    "QSalesUserPreferences": {
        "title": "Q-Sales User Preferences",
        "description": "User-specific preferences for Q-Sales, like pinned or hidden SmartViews.",
        "type": "object",
        "properties": {
            "hiddenSystemViewIds": { "type": "array", "items": { "type": "string" } },
            "pinnedViewIds": { "type": "array", "items": { "type": "string" } },
            "customOrder": { "type": "array", "items": { "type": "string" } },
            "lastSelectedViewId": { "type": "string" },
            "updatedAt": { "type": "string", "format": "date-time" }
        }
    },
    "Lead": {
      "title": "Lead",
      "description": "A sales lead in Q-Sales.",
      "type": "object",
      "properties": {
          "pipelineId": { "type": "string" },
          "stageId": { "type": "string" },
          "dealValue": { "type": "number" },
          "currency": { "type": "string" },
          "isClosed": { "type": "boolean" },
          "closedReason": { "type": "string", "enum": ["won", "lost", null] },
          "closedAt": { "type": "string", "format": "date-time" },
          "lostReasonCode": { "type": "string" },
          "lostReasonNote": { "type": "string" },
          "nextActionAt": { "type": "string", "format": "date-time" },
          "nextActionType": { "type": "string", "enum": ["call", "followup", "email", "meeting", null] },
          "lastActivityAt": { "type": "string", "format": "date-time" },
          "assigneeId": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "status": { "type": "string" },
          "ai": {
              "type": "object",
              "properties": {
                  "score": { "type": "number" },
                  "label": { "type": "string" },
                  "reasoning": { "type": "string" },
                  "riskFlags": { "type": "array", "items": { "type": "string" } },
                  "lastEvaluatedAt": { "type": "string", "format": "date-time" }
              }
          },
          "health": {
              "type": "object",
              "properties": {
                  "status": { "type": "string", "enum": ["healthy", "warning", "at_risk", null] },
                  "reasons": { "type": "array", "items": { "type": "string" } },
                  "lastCalculatedAt": { "type": "string", "format": "date-time" }
              }
          }
      }
    },
    "QSalesActivity": {
        "title": "Q-Sales Activity",
        "description": "Represents an activity like a call, email, or note in Q-Sales.",
        "type": "object",
        "properties": {
            "leadId": { "type": "string" },
            "type": { "type": "string", "enum": ["call", "email", "note", "meeting", "task_update"] },
            "createdBy": { "type": "object", "properties": { "userId": { "type": "string" }, "name": { "type": "string" }, "agent": { "type": "string" } } },
            "createdAt": { "type": "string", "format": "date-time" },
            "meta": {
                "type": "object",
                "properties": {
                    "direction": { "type": "string", "enum": ["inbound", "outbound"] },
                    "durationSec": { "type": "number" },
                    "recordingUrl": { "type": "string" },
                    "subject": { "type": "string" },
                    "channel": { "type": "string", "enum": ["phone", "email", "calendar", "manual"] }
                }
            },
            "content": {
                "type": "object",
                "properties": {
                    "text": { "type": "string" },
                    "transcript": { "type": "string" }
                }
            },
            "ai": {
                "type": "object",
                "properties": {
                    "summary": { "type": "string" },
                    "keyPoints": { "type": "array", "items": { "type": "string" } },
                    "objections": { "type": "array", "items": { "type": "string" } },
                    "nextSteps": { "type": "array", "items": { "type": "string" } },
                    "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative", null] }
                }
            }
        }
    },
    "QSalesTask": {
        "title": "Q-Sales Task",
        "description": "Represents a next action or follow-up in Q-Sales.",
        "type": "object",
        "properties": {
            "leadId": { "type": "string" },
            "title": { "type": "string" },
            "type": { "type": "string", "enum": ["call", "email", "followup", "meeting"] },
            "dueAt": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["open", "done", "canceled"] },
            "assigneeId": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" },
            "source": { "type": "object", "properties": { "kind": { "type": "string" }, "refId": { "type": "string" } } },
            "ai": { "type": "object", "properties": { "suggestion": { "type": "string" } } }
        }
    },
    "QSalesSequence": {
        "title": "Q-Sales Sequence",
        "description": "A template for a series of follow-up actions.",
        "type": "object",
        "properties": {
            "name": { "type": "string" },
            "scope": { "type": "string", "enum": ["private", "team", "org"] },
            "createdBy": { "type": "object", "properties": { "userId": { "type": "string" } } },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" },
            "isArchived": { "type": "boolean" },
            "stopRules": { "type": "object", "properties": { "stopOnReply": { "type": "boolean" }, "stopOnMeetingBooked": { "type": "boolean" }, "stopOnDealClosed": { "type": "boolean" } } },
            "steps": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "stepId": { "type": "string" },
                        "dayOffset": { "type": "number" },
                        "actionType": { "type": "string", "enum": ["email", "call", "followup"] },
                        "template": { "type": "object", "properties": { "subject": { "type": "string" }, "body": { "type": "string" }, "talkTrack": { "type": "string" } } }
                    }
                }
            },
            "aiAssist": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "style": { "type": "string" } } }
        }
    },
    "QSalesSequenceEnrollment": {
        "title": "Q-Sales Sequence Enrollment",
        "description": "Links a lead to a sequence.",
        "type": "object",
        "properties": {
            "sequenceId": { "type": "string" },
            "leadId": { "type": "string" },
            "status": { "type": "string", "enum": ["active", "paused", "completed", "stopped"] },
            "startedAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" },
            "currentStepIndex": { "type": "number" },
            "nextRunAt": { "type": "string", "format": "date-time" },
            "stoppedReason": { "type": "string" },
            "logs": { "type": "array", "items": { "type": "object", "properties": { "at": { "type": "string", "format": "date-time" }, "event": { "type": "string" }, "detail": { "type": "string" } } } }
        }
    },
    "QSalesConversationInsight": {
        "title": "Q-Sales Conversation Insight",
        "description": "AI-powered analysis of a sales call.",
        "type": "object",
        "properties": {
            "leadId": { "type": "string" },
            "activityId": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "scorecard": { "type": "object", "properties": { "talkRatio": { "type": "number" }, "decisionQuestionsAsked": { "type": "boolean" }, "budgetDiscussed": { "type": "boolean" }, "timelineDiscussed": { "type": "boolean" }, "nextStepConfirmed": { "type": "boolean" } } },
            "coaching": { "type": "object", "properties": { "strengths": { "type": "array", "items": { "type": "string" } }, "improvements": { "type": "array", "items": { "type": "string" } }, "recommendedNextQuestion": { "type": "string" } } }
        }
    },
    "QSalesReportingSnapshot": {
        "title": "Q-Sales Reporting Snapshot",
        "description": "Aggregated sales data for a specific period.",
        "type": "object",
        "properties": {
            "period": { "type": "string", "enum": ["daily", "weekly", "monthly"] },
            "startAt": { "type": "string", "format": "date-time" },
            "endAt": { "type": "string", "format": "date-time" },
            "metrics": { "type": "object" },
            "breakdowns": { "type": "object" }
        }
    },
    "QSalesForecastConfig": {
        "title": "Q-Sales Forecast Config",
        "description": "Configuration for sales forecasting.",
        "type": "object",
        "properties": {
            "forecastModel": { "type": "string" },
            "stageWeights": { "type": "object" },
            "aiOverridesEnabled": { "type": "boolean" },
            "scenarioPresets": { "type": "array" }
        }
    },
    "BusinessBuilderRun": {
      "title": "Business Builder Run",
      "description": "Represents a single run of the KI-powered Business Builder, either for auditing or creating processes.",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["audit", "new"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "analyzing", "ready", "imported", "failed"]
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "input": {
          "type": "object",
          "properties": {
            "industry": { "type": "string" },
            "companySize": { "type": "number" },
            "deptIds": { "type": "array", "items": { "type": "string" } },
            "goals": { "type": "array", "items": { "type": "string" } },
            "sources": {
              "type": "object",
              "properties": {
                "workInstructions": { "type": "boolean" },
                "docs": { "type": "boolean" },
                "tasks": { "type": "boolean" },
                "projects": { "type": "boolean" },
                "kpis": { "type": "boolean" }
              }
            }
          }
        },
        "resultsSummary": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "problem": { "type": "string" },
              "recommendation": { "type": "string" },
              "deptId": { "type": "string" },
              "effort": { "type": "string", "enum": ["S", "M", "L"] },
              "impact": { "type": "string", "enum": ["Low", "Med", "High"] },
              "outputType": { "type": "string", "enum": ["workInstruction", "taskPack", "project"] },
              "selected": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["mode", "status", "createdBy", "createdAt"]
    },
    "SuccessPlan": {
      "title": "Success Plan",
      "description": "Defines goals and targets for a specific period.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "periodType": { "type": "string", "enum": ["year", "quarter", "month"] },
        "startAt": { "type": "string", "format": "date-time" },
        "endAt": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "enum": ["org", "dept", "team"] },
        "deptId": { "type": "string" },
        "teamId": { "type": "string" },
        "ownerUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "archived"] },
        "targets": {
          "type": "object",
          "properties": {
            "revenue": { "type": "number" },
            "profit": { "type": "number" },
            "marginPct": { "type": "number" },
            "leads": { "type": "number" },
            "meetings": { "type": "number" },
            "closes": { "type": "number" }
          }
        },
        "breakdown": {
          "type": "object",
          "properties": {
            "monthlyTargets": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        },
        "aiSuggestion": { "type": "object" }
      },
      "required": ["name", "periodType", "startAt", "endAt", "scope", "ownerUserId", "status"]
    },
    "SuccessPlanActuals": {
      "title": "Success Plan Actuals",
      "description": "Tracks the actual performance against a success plan for a given period.",
      "type": "object",
      "properties": {
        "periodStart": { "type": "string", "format": "date-time" },
        "revenueActual": { "type": "number" },
        "leadsActual": { "type": "number" },
        "meetingsActual": { "type": "number" },
        "closesActual": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["periodStart", "updatedAt"]
    },
    "SuccessPlanAction": {
      "title": "Success Plan Action",
      "description": "A measure or action item derived from a success plan.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["taskPack", "project"] },
        "linkedTaskIds": { "type": "array", "items": { "type": "string" } },
        "linkedProjectId": { "type": "string" },
        "ownerUserId": { "type": "string" },
        "dueAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["open", "in_progress", "done"] }
      },
      "required": ["title", "type", "ownerUserId", "status"]
    },
    "LeaveRequest": {
      "title": "Leave Request",
      "description": "Represents an employee's request for leave.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deptId": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "leaveType": { "type": "string", "enum": ["urlaub", "krankheit", "sonderurlaub"] },
        "comment": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "approved", "rejected"] },
        "approverUserId": { "type": "string" },
        "aiAssessment": {
          "type": "object",
          "properties": {
            "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
            "summary": { "type": "string" },
            "conflicts": { "type": "array", "items": { "type": "string" } }
          }
        },
        "escalationThreadId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "deptId", "startDate", "endDate", "leaveType", "status", "createdAt", "updatedAt"]
    },
    "DayPlannerSettings": {
      "title": "Day Planner Settings",
      "description": "User-specific settings for the Day Planner.",
      "type": "object",
      "properties": {
        "workdayStart": { "type": "string" },
        "workdayEnd": { "type": "string" },
        "breakBlocks": { "type": "array", "items": { "type": "object", "properties": { "start": { "type": "string" }, "end": { "type": "string" } } } },
        "planningHorizonDays": { "type": "number" },
        "autoPlanOnOpen": { "type": "boolean" },
        "allowOvertime": { "type": "boolean" }
      }
    },
    "DayPlannerQuickTask": {
      "title": "Day Planner Quick Task",
      "description": "A user-created task within the Day Planner.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deptId": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "dueAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["open", "done", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ai": {
            "type": "object",
            "properties": {
                "estimateMin": { "type": "number" },
                "confidence": { "type": "number" },
                "priorityScore": { "type": "number" },
                "reason": { "type": "string" }
            }
        }
      },
      "required": ["userId", "title", "status", "createdAt", "updatedAt"]
    },
    "DayPlan": {
        "title": "Day Plan",
        "description": "Represents a single day's plan in the Day Planner.",
        "type": "object",
        "properties": {
            "userId": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "status": { "type": "string", "enum": ["draft", "active", "final"] },
            "generatedBy": { "type": "string", "enum": ["ai", "user", "mixed"] },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "date", "status", "createdAt", "updatedAt"]
    },
    "DayPlanBlock": {
        "title": "Day Plan Block",
        "description": "A single scheduled block within a Day Plan.",
        "type": "object",
        "properties": {
            "sourceType": { "type": "string", "enum": ["workspaceTask", "quickTask"] },
            "sourceId": { "type": "string" },
            "titleSnapshot": { "type": "string" },
            "startAt": { "type": "string", "format": "date-time" },
            "endAt": { "type": "string", "format": "date-time" },
            "priorityScore": { "type": "number" },
            "estimateMin": { "type": "number" },
            "aiReason": { "type": "string" },
            "locked": { "type": "boolean" },
            "status": { "type": "string", "enum": ["planned", "in_progress", "done", "skipped"] }
        },
        "required": ["sourceType", "sourceId", "titleSnapshot", "startAt", "endAt"]
    },
    "TimeSettings": {
      "title": "Time Tracking Settings",
      "description": "Defines target work hours for an organization or user.",
      "type": "object",
      "properties": {
        "scopeType": {
          "type": "string",
          "enum": [
            "org",
            "user"
          ]
        },
        "userId": {
          "type": "string"
        },
        "targetWorkMinPerDay": {
          "type": "number",
          "description": "Target work minutes per day, e.g., 480 for 8 hours."
        },
        "workdays": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Array of numbers representing days of the week, e.g., [1,2,3,4,5] for Mon-Fri."
        }
      },
      "required": [
        "scopeType",
        "targetWorkMinPerDay",
        "workdays"
      ]
    },
    "TimeEntry": {
      "title": "Time Entry",
      "description": "A single time entry record for a user, compliant with legal work time tracking requirements.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deptId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "workStartAt": { "type": "string", "format": "date-time", "description": "Start of the work day for this entry." },
        "workEndAt": { "type": "string", "format": "date-time", "description": "End of the work day for this entry." },
        "breakMin": { "type": "number", "description": "Total break time in minutes for the work day." },
        "totalWorkMin": { "type": "number", "description": "Total net work time in minutes for the day, calculated automatically." },
        "status": { "type": "string", "enum": ["open", "completed"] },
        "modified": { "type": "boolean", "description": "Flag indicating if the entry was modified after its initial creation." },
        "modificationReason": { "type": "string", "description": "Reason for the modification, required if modified is true." },
        "modifiedBy": { "type": "string", "description": "User ID of the person who last modified the entry." },
        "modifiedAt": { "type": "string", "format": "date-time", "description": "Timestamp of the last modification." },
        "originalStartAt": { "type": "string", "format": "date-time", "description": "Original start time of the entry, preserved for audit." },
        "originalEndAt": { "type": "string", "format": "date-time", "description": "Original end time of the entry, preserved for audit." },
        "originalBreakMin": { "type": "number", "description": "Original break time in minutes, preserved for audit." },
        "overtimeMin": { "type": "number", "description": "Total overtime in minutes for the day." },
        "undertimeMin": { "type": "number", "description": "Total undertime in minutes for the day." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", 
        "deptId", 
        "date", 
        "workStartAt", 
        "breakMin",
        "status", 
        "createdAt", 
        "updatedAt",
        "modified"
      ]
    },
    "RunningTimer": {
      "title": "Running Timer",
      "description": "Represents a user's currently running timer.",
      "type": "object",
      "properties": {
        "entryId": { "type": "string" },
        "startAt": { "type": "string", "format": "date-time" },
        "contextType": { "type": "string", "enum": ["task", "project", "workInstruction", "general"] },
        "contextId": { "type": "string" },
        "isRunning": { "type": "boolean" }
      },
      "required": ["entryId", "startAt", "isRunning"]
    },
    "WeeklyBatch": {
      "title": "Weekly Time Batch",
      "description": "A batch of time entries for a user for one week, used for approvals.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "weekStart": { "type": "string", "format": "date" },
        "weekEnd": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected"] },
        "totalMin": { "type": "number" },
        "approverUserId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "weekStart", "weekEnd", "status", "totalMin", "createdAt", "updatedAt"]
    },
    "TimeAdminSettings": {
      "title": "Time Admin Settings",
      "description": "Configuration for administrative corrections of time entries.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "allowedRoles": { "type": "array", "items": { "type": "string" }, "default": ["exec"] },
        "maxBackdateDays": { "type": "number", "default": 30 },
        "allowSpaceAdmin": { "type": "boolean", "default": false }
      }
    },
    "QTraceSettings": {
      "title": "Q-Trace Settings",
      "description": "Tenant-wide feature toggle and retention configuration for Q-Trace.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "allowInternalCalls": { "type": "boolean" },
        "allowInboundCalls": { "type": "boolean" },
        "allowOutboundCalls": { "type": "boolean" },
        "audioTTLMinutes": { "type": "number" },
        "audioHardcapHours": { "type": "number" },
        "draftReviewRequired": { "type": "boolean" },
        "qspaceIntegration": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "QTraceProvider": {
      "title": "Q-Trace Provider",
      "description": "Configuration for a webhook provider for Q-Trace.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "providerId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "secret": { "type": "string" },
        "signatureHeaderName": { "type": "string" },
        "timestampHeaderName": { "type": "string" },
        "idHeaderName": { "type": "string" },
        "maxSkewSeconds": { "type": "number" }
      }
    },
    "QTraceCall": {
      "title": "Q-Trace Call",
      "description": "Represents a single call processed by the Q-Trace feature.",
      "type": "object",
      "properties": {
        "qtraceCallId": { "type": "string" },
        "tenantId": { "type": "string" },
        "linkedQCallId": { "type": ["string", "null"] },
        "providerId": { "type": "string" },
        "providerCallId": { "type": "string" },
        "direction": { "type": "string", "enum": ["internal", "inbound", "outbound"] },
        "teamId": { "type": ["string", "null"] },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "userId": { "type": "string" },
              "role": { "type": "string", "enum": ["agent", "participant", "lead"] }
            }
          }
        },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationSec": { "type": ["number", "null"] },
        "recording": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["skipped", "recording", "uploaded", "deleted", "error"] },
            "tempStoragePath": { "type": ["string", "null"] },
            "ttlDeleteAt": { "type": ["string", "null"], "format": "date-time" },
            "hardcapDeleteAt": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "transcript": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["pending", "processing", "ready", "error"] },
            "language": { "type": "string" },
            "text": { "type": ["string", "null"] },
            "readyAt": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "qtrace": {
          "type": "object",
          "properties": {
            "status": { "type": "string", "enum": ["inactive", "pending", "draft_ready", "finalized", "error"] },
            "summary": { "type": "array", "items": { "type": "string" } },
            "decisions": { "type": "array", "items": { "type": "string" } },
            "draftCount": { "type": "number" },
            "finalTaskIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "visibleToUserIds": { "type": "array", "items": { "type": "string" } },
            "teamId": { "type": ["string", "null"] }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "QTraceDraft": {
      "title": "Q-Trace Draft",
      "description": "An AI-generated task draft from a call transcript.",
      "type": "object",
      "properties": {
        "draftId": { "type": "string" },
        "tenantId": { "type": "string" },
        "qtraceCallId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "suggestedOwnerUserId": { "type": ["string", "null"] },
        "ownerUserId": { "type": ["string", "null"] },
        "dueAt": { "type": ["string", "null"], "format": "date-time" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "confidence": { "type": "number" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "quote": { "type": "string" },
              "startSec": { "type": ["number", "null"] },
              "endSec": { "type": ["number", "null"] }
            }
          }
        },
        "status": { "type": "string", "enum": ["draft", "approved", "rejected", "edited"] },
        "finalTaskId": { "type": ["string", "null"] },
        "approvedByUserId": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "QTraceWebhookEvent": {
      "title": "Q-Trace Webhook Event",
      "description": "Logs an incoming webhook event for Q-Trace.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "tenantId": { "type": "string" },
        "providerId": { "type": "string" },
        "type": { "type": "string", "enum": ["call.started", "call.ended", "recording.ready", "recording.failed"] },
        "providerCallId": { "type": "string" },
        "status": { "type": "string", "enum": ["received", "processed", "ignored", "error"] },
        "error": { "type": ["string", "null"] },
        "receivedAt": { "type": "string", "format": "date-time" },
        "processedAt": { "type": ["string", "null"], "format": "date-time" },
        "payload": { "type": "object" }
      }
    },
    "QTraceEvent": {
      "title": "Q-Trace Event",
      "description": "Logs an internal pipeline event for Q-Trace.",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "qtraceCallId": { "type": "string" },
        "type": { "type": "string", "enum": ["stt_started", "stt_ready", "drafts_created", "draft_approved", "draft_rejected", "tasks_created", "recording_deleted", "error"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
