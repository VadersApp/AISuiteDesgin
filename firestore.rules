rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // SmartViews rules
    match /organizations/{orgId}/q_sales_smartviews/{viewId} {
        // All authenticated users in the org can read system views.
        // For custom views, check scope.
        allow read: if request.auth != null && (
            resource.data.type == 'system' ||
            (resource.data.scope == 'private' && resource.data.createdBy.userId == request.auth.uid) ||
            resource.data.scope == 'team' || // V1: team is org-wide for reads
            resource.data.scope == 'org'
        );

        // Can create custom views.
        allow create: if request.auth != null && request.resource.data.type == 'custom' && request.resource.data.createdBy.userId == request.auth.uid;
        
        // Cannot update system views.
        // Can update custom views based on permissions.
        allow update: if request.auth != null && resource.data.type == 'custom' && (
            (resource.data.scope == 'private' && resource.data.createdBy.userId == request.auth.uid) ||
            (resource.data.scope == 'team' && resource.data.createdBy.userId == request.auth.uid) // V1: only owner can edit team views
        );

        // Cannot delete system views.
        // Can delete (archive) their own private/team views.
        allow delete: if request.auth != null && resource.data.type == 'custom' && resource.data.createdBy.userId == request.auth.uid;
    }

    // User Preferences rules
    match /organizations/{orgId}/users/{userId}/q_sales_preferences/smartviews {
        // Users can only read and write their own preferences.
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /organizations/{orgId}/q_sales_leads/{leadId} {
        // Allow read/write for authenticated users.
        // In a real app, this would be more granular based on org/team membership.
        allow read, write: if request.auth != null;
    }
    
    match /organizations/{orgId}/q_sales_activities/{activityId} {
      allow read, write: if request.auth != null;
    }

    match /organizations/{orgId}/q_sales_tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /organizations/{orgId}/q_sales_sequences/{sequenceId} {
      allow read, write: if request.auth != null;
    }

    match /organizations/{orgId}/q_sales_sequence_enrollments/{enrollmentId} {
      allow read, write: if request.auth != null;
    }

    match /organizations/{orgId}/q_sales_conversation_insights/{insightId} {
      allow read, write: if request.auth != null;
    }

    match /organizations/{orgId}/q_sales_reporting_snapshots/{snapshotId} {
      allow read, write: if request.auth != null;
    }

    match /organizations/{orgId}/q_sales_forecast_config/main {
      allow read, write: if request.auth != null; // Should be admin only in real app
    }
    
    // Business Builder Rules
    match /organizations/{orgId}/businessBuilderRuns/{runId} {
      // For now, allow authenticated users to read/write.
      // In a real app, this would be more granular (e.g., admin/owner roles).
      allow read, write: if request.auth != null;
    }

    // Success Planner Rules
    match /organizations/{orgId}/successPlans/{planId} {
      allow read, write: if request.auth != null;
    }
    match /organizations/{orgId}/successPlans/{planId}/actuals/{periodId} {
      allow read, write: if request.auth != null;
    }
    match /organizations/{orgId}/successPlans/{planId}/actions/{actionId} {
      allow read, write: if request.auth != null;
    }

    // Leave Planner Rules
    match /organizations/{orgId}/leaveRequests/{requestId} {
      // Users can create and read their own requests.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'exec') ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_head' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deptId == resource.data.deptId)
      );
      
      // Approvers (exec, dept_head) can update status. Users can cancel their own if submitted.
      allow update: if request.auth != null && (
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'exec' ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_head' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deptId == resource.data.deptId)
          ) ||
          (resource.data.status == 'submitted' && request.auth.uid == resource.data.userId) // User can cancel their own submitted requests
      );
      
      // Users can delete their own requests if they haven't been processed yet.
      allow delete: if request.auth != null && resource.data.status == 'submitted' && request.auth.uid == resource.data.userId;
    }

    // Day Planner Rules
    match /organizations/{orgId}/dayPlannerSettings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /organizations/{orgId}/dayPlannerQuickTasks/{taskId} {
      allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/organizations/$(orgId)/dayPlannerQuickTasks/$(taskId)).data.userId == request.auth.uid;
    }
    match /organizations/{orgId}/dayPlans/{planId} {
      allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/organizations/$(orgId)/dayPlans/$(planId)).data.userId == request.auth.uid;
    }
    match /organizations/{orgId}/dayPlans/{planId}/blocks/{blockId} {
        // Only the owner of the plan can manage its blocks
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/organizations/$(orgId)/dayPlans/$(planId)).data.userId == request.auth.uid;
    }

    // Time Tracking Rules
    match /organizations/{orgId}/timeEntries/{entryId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'exec') ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_head' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deptId == resource.data.deptId)
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        // User can update their own drafts
        (resource.data.userId == request.auth.uid && resource.data.status == 'draft') ||
        // User can submit their own drafts
        (resource.data.userId == request.auth.uid && request.resource.data.status == 'submitted') ||
        // Approver can approve/reject
        (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'exec' ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_head' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deptId == resource.data.deptId)
        )
      );
      // No deletes in MVP
      allow delete: if false;
    }

    match /organizations/{orgId}/runningTimers/{userId} {
      // User can only manage their own timer
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /organizations/{orgId}/timeBatches/{batchId} {
        allow read: if request.auth != null && (
            resource.data.userId == request.auth.uid ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'exec') ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_head' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deptId == get(/databases/$(database)/documents/users/$(resource.data.userId)).data.deptId)
        );
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null && (
            (resource.data.userId == request.auth.uid && resource.data.status == 'draft') ||
            // Approver can approve/reject
             (
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'exec' ||
                (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dept_head' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deptId == get(/databases/$(database)/documents/users/$(resource.data.userId)).data.deptId)
            )
        );
         allow delete: if false;
    }
  }
}
